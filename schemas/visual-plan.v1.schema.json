{
  "$defs": {
    "ProductionOpportunity": {
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        },
        "sfx_suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sfx Suggestion"
        },
        "sfx_recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SfxRecommendation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edit_suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edit Suggestion"
        }
      },
      "required": [
        "trigger"
      ],
      "title": "ProductionOpportunity",
      "type": "object"
    },
    "SfxRecommendation": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sfx",
          "default": "sfx",
          "title": "Type",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "sfx_kind": {
          "enum": [
            "one_shot",
            "ambient"
          ],
          "title": "Sfx Kind",
          "type": "string"
        },
        "desired_sound": {
          "minLength": 1,
          "title": "Desired Sound",
          "type": "string"
        },
        "search_queries": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Search Queries",
          "type": "array"
        },
        "intensity": {
          "minLength": 1,
          "title": "Intensity",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "purpose",
        "sfx_kind",
        "desired_sound",
        "search_queries",
        "intensity"
      ],
      "title": "SfxRecommendation",
      "type": "object"
    },
    "VisualPlanBeat": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "title": "Beat Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "narration_context": {
          "minLength": 1,
          "title": "Narration Context",
          "type": "string"
        },
        "desired_visual": {
          "minLength": 1,
          "title": "Desired Visual",
          "type": "string"
        },
        "search_queries": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Search Queries",
          "type": "array"
        },
        "must_have": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Must Have",
          "type": "array"
        },
        "avoid": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Avoid",
          "type": "array"
        },
        "media_preference": {
          "enum": [
            "image",
            "video",
            "either"
          ],
          "title": "Media Preference",
          "type": "string"
        },
        "source_requirement": {
          "enum": [
            "representative",
            "exact"
          ],
          "title": "Source Requirement",
          "type": "string"
        },
        "production_opportunities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProductionOpportunity"
          },
          "title": "Production Opportunities",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "sequence",
        "narration_context",
        "desired_visual",
        "search_queries",
        "media_preference",
        "source_requirement"
      ],
      "title": "VisualPlanBeat",
      "type": "object"
    },
    "VisualPlanStory": {
      "additionalProperties": false,
      "properties": {
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "story_id",
        "title"
      ],
      "title": "VisualPlanStory",
      "type": "object"
    }
  },
  "$id": "https://yt-visuals.local/schemas/visual-plan.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "visual_plan",
      "title": "Document Type",
      "type": "string"
    },
    "contract_version": {
      "const": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "story": {
      "$ref": "#/$defs/VisualPlanStory"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/VisualPlanBeat"
      },
      "minItems": 1,
      "title": "Beats",
      "type": "array"
    }
  },
  "required": [
    "document_type",
    "contract_version",
    "story",
    "beats"
  ],
  "title": "Visual Plan v1",
  "type": "object"
}
