# Optional repository-root override. Leave empty to use automatic discovery.
YT_VISUALS_ROOT=

# Pexels API credential. Put the real value in your environment or ignored .env file.
PEXELS_API_KEY=

# Optional acquisition safety limits (bytes). Defaults: 50 MiB images, 500 MiB videos.
YT_VISUALS_MAX_IMAGE_DOWNLOAD_BYTES=
YT_VISUALS_MAX_VIDEO_DOWNLOAD_BYTES=
