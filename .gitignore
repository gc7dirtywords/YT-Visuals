.venv/
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

Data/*
!Data/.gitkeep
Temp/*
!Temp/.gitkeep
Library/Images/*
!Library/Images/.gitkeep
Library/Videos/*
!Library/Videos/.gitkeep

# Generated visual-review iteration artifacts; preserve other Projects content.
Projects/*/visuals/*/iterations/

# Producer-led DaVinci handoff folders are generated from catalog masters.
Projects/*/Edit/

# Prevent media copied into other folders from being committed accidentally.
*.3gp
*.avi
*.bmp
*.flac
*.gif
*.heic
*.jpeg
*.jpg
